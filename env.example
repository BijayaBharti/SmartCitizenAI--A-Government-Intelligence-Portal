# Rename this file to .env and fill in your keys.
# You can also paste keys directly into the app's sidebar instead of using this file.

# Get a free Gemini API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Get a free Tavily API key from https://tavily.com (only needed for the Live Search tab)
TAVILY_API_KEY=your_tavily_api_key_here
